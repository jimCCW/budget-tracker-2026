DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>
JWT_SECRET=<generate-a-strong-random-secret>
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email — optional. Leave unset locally: activation codes and reset links are then
# logged to the console with a [DEV] prefix instead of being emailed.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="Budget Tracker <onboarding@resend.dev>"
